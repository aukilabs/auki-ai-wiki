FROM node:18-alpine AS builder
RUN apk add --no-cache python3 make g++
ARG VITE_API_URL
ARG VITE_DDS_URL
ARG VITE_NCS_URL
ARG VITE_DOCUMENTATION_URL
ARG VITE_STADIA_MAPS_API_KEY
ARG VITE_CONTRACTS_CHAIN_ID
ARG VITE_CONTRACTS_CHAIN_NAME
ARG VITE_CONTRACTS_CHAIN_CURRENCY_NAME
ARG VITE_CONTRACTS_CHAIN_CURRENCY_SYMBOL
ARG VITE_CONTRACTS_CHAIN_RPC_URL
ARG VITE_AUKI_TOKEN_ADDRESS
ARG VITE_BURN_CONTRACT_ADDRESS
ARG VITE_DEDICATED_MODE_STAKING_CONTRACT_ADDRESS
ARG VITE_PUBLIC_MODE_STAKING_CONTRACT_ADDRESS
ARG VITE_COMPUTE_DEDICATED_MODE_STAKING_CONTRACT_ADDRESS
ARG VITE_COMPUTE_PUBLIC_MODE_STAKING_CONTRACT_ADDRESS
ARG VITE_REWARD_LIQUIDITY_POOL_CONTRACT_ADDRESS
ARG VITE_DOMAIN_NFT_ADDRESS
ARG VITE_DOMAIN_NFT_STAKING_CONTRACT_ADDRESS
ARG VITE_CONFIRMATION_COUNT
ARG VITE_WALLETCONNECT_PROJECT_ID
ARG VITE_REWARD_DURATION_SECS
ARG VITE_TOTAL_REWARD_BUDGET
ARG VITE_BASE_REWARD_BUDGET
ARG VITE_PER_ZONE_REWARD_BUDGET
ARG VITE_PER_ISP_REWARD_CAP
ARG VITE_DS_REWARD_DURATION_SECS
ARG VITE_DS_TOTAL_REWARD_BUDGET
ARG VITE_DS_BASE_REWARD_BUDGET
ARG VITE_DS_PER_ZONE_REWARD_BUDGET
ARG VITE_DS_PER_ISP_REWARD_CAP
ARG VITE_APP_VERSION
WORKDIR /app
COPY package.json package-lock.json /app/
RUN npm install
COPY ./ /app
ENV VITE_APP_VERSION=$VITE_APP_VERSION
RUN npm run build

FROM nginx:stable-alpine
COPY --from=builder /app/dist /usr/share/nginx/html
ADD nginx-default.conf /etc/nginx/conf.d/default.conf
